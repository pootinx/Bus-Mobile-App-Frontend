rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER: Check if user is admin
    // ============================================================
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================================
    // HELPER: Check if user is authenticated
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // ============================================================
    // HELPER: Check if user owns a resource
    // ============================================================
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // USER PROFILES
    // ============================================================
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================================
    // USER SURVEY STATES
    // ============================================================
    match /userSurveyStates/{stateId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // IN-APP NOTIFICATIONS
    // ============================================================
    match /inAppNotifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      ) && request.resource.data.keys().hasOnly(['read', 'clicked', 'isRead']);
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // SURVEY QUESTIONS (Question Library)
    // ============================================================
    match /surveyQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // DAILY SURVEYS (Survey Campaigns)
    // ============================================================
    match /dailySurveys/{surveyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // SURVEY ANSWERS
    // - Users can create their own answers
    // - Admins can read all for analytics
    // - uid field identifies the owner
    // ============================================================
    match /surveyAnswers/{answerId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // ANALYTICS EVENTS
    // ============================================================
    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // AGGREGATED METRICS
    // ============================================================
    match /aggregatedMetrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // SURVEY WORKFLOW LOGS
    // - Admins only
    // ============================================================
    match /surveyWorkflowLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // NOTIFICATIONS (admin dashboard)
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // ADMIN COLLECTION
    // ============================================================
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    // ============================================================
    // CITIES COLLECTION
    // ============================================================
    match /cities/{cityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // SYSTEM LOGS
    // ============================================================
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // DEFAULT: DENY ALL
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
